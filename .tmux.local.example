# Local menu on "c-q c-r c-l".
# PLEASE DONT USE: "j", "k", "q" IN ANY MENU!

bind -T menus "c-l" display-menu -T " Local... " \
"Git clone our project .............." "c" "send-keys 'git config --global user.name \"user\" && git config --global user.email \"user@example.com\" && git clone git@github.com:...' enter" \
"llama.cpp (g)emma-4-e2b ............" "g" "send-keys ' llama-server --webui-mcp-proxy -hf unsloth/gemma-4-E2B-it-GGUF:UD-Q4_K_XL' enter" \
"" \
"Reload tmux.local .................." "0" "source-file ~/.tmux.local"
